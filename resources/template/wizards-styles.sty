
\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage
  {wizards-styles}
  [2026/08/04 v0.1.0 Core WIZARDS styling framework]


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% External packages
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Colors
\PassOptionsToPackage{table}{xcolor}

\RequirePackage{xcolor}
\RequirePackage{colortbl}

% Tables
\RequirePackage{array}
\RequirePackage{tabularx}

% Layout
\RequirePackage{geometry}
\RequirePackage{ragged2e}
\RequirePackage{microtype}

% Graphics
\RequirePackage{tikz}

% Boxes
\RequirePackage[breakable,skins,xparse]{tcolorbox}

% Lists
\RequirePackage{enumitem}

% Utility
\RequirePackage{xparse}
\RequirePackage{etoolbox}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Global layout
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\geometry{
    hmargin   = .75in,
    top       = .46in,
    bottom    = .80in,
    footskip  = .32in,
    columnsep = .33in,
}

\setlength{\parindent}{1em}

\RaggedRight

\setlist{
    leftmargin=1em
}

\setitemize{
    noitemsep,
    topsep=0.5ex,
    label=\footnotesize\textbullet
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WIZARDS modules
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{styles/theme/background}
\RequirePackage{styles/theme/colors}
\RequirePackage{styles/theme/fonts}
\RequirePackage{styles/theme/header}

\RequirePackage{styles/util/keywords}
\RequirePackage{styles/util/rolls}

\RequirePackage{styles/layout/box}
\RequirePackage{styles/layout/sections}
\RequirePackage{styles/layout/table}
\RequirePackage{styles/layout/toc}


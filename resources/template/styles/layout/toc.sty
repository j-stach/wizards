
\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage
  {toc}
  [2026/08/04 v0.1.0 Table of contents generator for WIZARDS]

\RequirePackage{titletoc}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Table of Contents
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Display entries through the section level.
\setcounter{tocdepth}{1}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Shared formatting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\providecommand{\tocchapapp}{\chaptername}

\newcommand{\WizardsTOCLeader}{%
  \titlerule*{.}\contentspage%
}

\newcommand{\WizardsTOCPartAfter}{%
  \addvspace{-0.03in}%
  \titleline{\color{wizards-primary}\titlerule[1pt]}%
  \addvspace{0.05in}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Part entries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\titlecontents{part}
  [0pt]
  {
    \addvspace{0.06in}
    \WizardsPartFont
  }
  {
    \partname\ \thecontentslabel :\enspace
  }
  {}
  {}
  [
    \WizardsTOCPartAfter
  ]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Chapter entries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\titlecontents{chapter}
  [0pt]
  {
    \addvspace{0.10in}
    \WizardsChapterFont
  }
  {
    \tocchapapp\ \thecontentslabel :\enspace
  }
  {}
  {
    \WizardsTOCLeader
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section entries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\titlecontents{section}
  [0pt]
  {
    \WizardsSectionFont
  }
  {
    \thecontentslabel :\enspace
  }
  {}
  {
    \WizardsTOCLeader
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Appendix support
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\AddToHook{cmd/appendix/after}{%
  \renewcommand{\tocchapapp}{\appendixname}%
}



\ProvidesExplPackage
  {box}
  {2026/08/04}
  {0.1.0}
  {Box environments for the WIZARDS rulebook}

\RequirePackage{xparse}
\RequirePackage[skins,breakable]{tcolorbox}

\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Base box style
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tcbset{
    wizards box/.style={
        enhanced,
        breakable,
        frame~hidden,

        colback = white,
        colframe = black,
        opacityback = 0.30,

        boxrule = 0pt,
        boxsep  = 8pt,

        left   = 6pt,
        right  = 6pt,
        top    = 6pt,
        bottom = 6pt,

        before~skip = 12pt,
        after~skip  = 12pt,

        borderline~west = {2pt}{0pt}{black},

        fonttitle = \WizardsBoxTitleFont,
        fontupper = \WizardsBoxBodyFont,

        title~filled = true, %false,
        coltitle = wizards-primary,
        colbacktitle = wizards-secondary,
        opacitybacktitle = 0.50,
    },
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Generic box
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentEnvironment{WizardsBox}{ O{} O{} }
{
    \begin{tcolorbox}[
        wizards box,
        title = {#1},
        #2
    ]
}
{
    \end{tcolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Semantic box types
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentEnvironment{Example}{ O{} }
{
    \begin{WizardsBox}
        [Example\IfValueT{#1}{: #1}]
        [borderline~west={2pt}{0pt}{wizards-secondary}]
}
{
    \end{WizardsBox}
}

\NewDocumentEnvironment{Rule}{ O{} }
{
    \begin{WizardsBox}
        [Rule\IfValueT{#1}{: #1}]
        [borderline~west={2pt}{0pt}{wizards-secondary}]
}
{
    \end{WizardsBox}
}

\NewDocumentEnvironment{Lore}{ O{} }
{
    \begin{WizardsBox}
        [Lore\IfValueT{#1}{: #1}]
        [borderline~west={2pt}{0pt}{wizards-secondary}]
}
{
    \end{WizardsBox}
}

\NewDocumentEnvironment{DesignerNote}{ O{} }
{
    \begin{WizardsBox}
        [Designer~Note\IfValueT{#1}{: #1}]
        [borderline~west={2pt}{0pt}{wizards-secondary}]
}
{
    \end{WizardsBox}
}

\NewDocumentEnvironment{OptionalRule}{ O{} }
{
    \begin{WizardsBox}
        [Optional~Rule\IfValueT{#1}{: #1}]
        [borderline~west={2pt}{0pt}{wizards-secondary}]
}
{
    \end{WizardsBox}
}

\NewDocumentEnvironment{Warning}{ O{} }
{
    \begin{WizardsBox}
        [Warning\IfValueT{#1}{: #1}]
        [borderline~west={2pt}{0pt}{red}]
}
{
    \end{WizardsBox}
}


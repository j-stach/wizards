
\NeedsTeXFormat{LaTeX2e}

\ProvidesExplPackage
  {rolls}
  {2026/08/04}
  {0.1.0}
  {Dice and roll utilities for WIZARDS}

\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Roll parser
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\regex_const:Nn
  \c__wizards_valid_roll_regex
  {
    \A\s*(\d+)[dD](\d+)\s*(?:([+\-])\s*(\d+))?\s*\Z
    %\A\s*(\d+)(?:[dD](\d+)\s*(?:([+\-])\s*(\d+))?)?\s*\Z
  }

\seq_new:N \l__wizards_roll_args_seq
\tl_new:N \l__wizards_roll_number_tl
\tl_new:N \l__wizards_roll_sides_tl
\tl_new:N \l__wizards_roll_mod_sign_tl
\tl_new:N \l__wizards_roll_mod_tl

\msg_new:nnn
  { wizards }
  { roll / invalid_argument }
  {
    Invalid~argument~``#1''~passed~to~
    \noexpand\Roll.
  }


\NewDocumentCommand{\Roll}{m}
{
    \group_begin:

    \regex_extract_once:NnNTF
      \c__wizards_valid_roll_regex
      {#1}
      \l__wizards_roll_args_seq
    {
        \tl_set:Nx
          \l__wizards_roll_number_tl
          { \seq_item:Nn \l__wizards_roll_args_seq {2} }

        \tl_set:Nx
          \l__wizards_roll_sides_tl
          { \seq_item:Nn \l__wizards_roll_args_seq {3} }

        \tl_set:Nx
          \l__wizards_roll_mod_sign_tl
          { \seq_item:Nn \l__wizards_roll_args_seq {4} }

        \tl_set:Nx
          \l__wizards_roll_mod_tl
          { \seq_item:Nn \l__wizards_roll_args_seq {5} }


        \tl_use:N
          \l__wizards_roll_number_tl

        d

        \tl_use:N
          \l__wizards_roll_sides_tl

        \tl_if_empty:NF
          \l__wizards_roll_mod_tl
        {
            \c_space_tl
            \tl_use:N
              \l__wizards_roll_mod_sign_tl
            \c_space_tl
            \tl_use:N
              \l__wizards_roll_mod_tl
        }
    }
    {
        \msg_error:nnn
          { wizards }
          { roll / invalid_argument }
          { #1 }
    }

    \group_end:
}

\ExplSyntaxOff


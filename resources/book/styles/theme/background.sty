
\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage
  {background}
  [2026/08/04 v0.1.0 Page background styling for WIZARDS]

\RequirePackage{tikz}
\RequirePackage{graphicx}

% TODO Toggle Background for printer-friendly version

% Page background
\NewDocumentCommand{\PageBackground}{}
{
  \begin{tikzpicture}
    [
      remember picture,
      overlay
    ]
    \node[
      inner sep=0pt
    ]
    at (current page.center)
    {
      \includegraphics[
        width=\paperwidth,
        height=\paperheight
      ]{assets/paper}
    };
  \end{tikzpicture}
}

% Apply background to every page
\AddToHook{shipout/background}
{
  \PageBackground
}



\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage
  {fonts}
  [2026/08/04 v0.1.0 Typography for WIZARDS]

\RequirePackage[T1]{fontenc}
\RequirePackage{kpfonts}
\RequirePackage[type1]{gillius2}
\RequirePackage{lettrine}
\RequirePackage[auto]{contour}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Font families
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\WizardsBodyFont}
{
    \rmfamily
}

\newcommand{\WizardsHeadingFont}
{
    \sffamily
    \bfseries
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Document elements
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\WizardsPartFont}
{
    \WizardsHeadingFont
    \Huge
    \scshape
}

\newcommand{\WizardsChapterFont}
{
    \WizardsHeadingFont
    \Huge
    \scshape
}

\newcommand{\WizardsSectionFont}
{
    \WizardsHeadingFont
    \Large
    \scshape
}

\newcommand{\WizardsSubsectionFont}
{
    \WizardsHeadingFont
    \scshape
}

\newcommand{\WizardsBoxTitleFont}
{
    \sffamily
    \bfseries
    \scshape
}

\newcommand{\WizardsBoxBodyFont}
{
    \small
}

\newcommand{\WizardsTableFont}
{
    \small
}

\newcommand{\FooterFont}
{
    \WizardsBodyFont
}

\newcommand{\PageNumberFont}
{
    \WizardsBodyFont
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Drop caps
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\renewcommand{\LettrineFontHook}
{
    \WizardsHeadingFont
}

\NewDocumentCommand{\WizardsDropCap}{ O{} m m }
{
    \lettrine[
        lines=4,
        depth=0,
        #1
    ]
    {#2}
    {#3}
}

% Contoured font for section headings
\newcommand{\WizardsContour}[2][gray]
{
  \contour{#1}{#2}%
}
